# Copie para .env e preencha. O .env NUNCA vai para o git.

# --- Coleta autônoma (Mapillary) ---
# Token de cliente: https://www.mapillary.com/dashboard/developers
MAPILLARY_TOKEN=
# minLon,minLat,maxLon,maxLat — use uma área pequena (poucos quarteirões)
MAPILLARY_BBOX=
# quantas imagens novas baixar por execução (em hospedagem pequena, como o Render gratuito, use 3)
MAPILLARY_LIMIT=10

# --- Modelo ---
# Vazio = usa weights/best.onnx (ou best.pt); se não existir, cai no baseline clássico
MODEL_WEIGHTS=
CONF_THRESHOLD=0.25
IMG_SIZE=640
# letterbox = detector recebe a imagem só redimensionada, como no treino (recall medido: 0,58)
# processed = após CLAHE + bilateral (recall medido: 0,46)
DETECT_ON=letterbox

# --- Medição ---
# Largura real (cm) que a foto cobre no chão; converte pixels em cm²
SCENE_WIDTH_CM=400

# --- Automação ---
PIPELINE_INTERVAL_SECONDS=300
# URL que recebe um POST JSON a cada dano de severidade alta (robô RPA / n8n / webhook.site)
WEBHOOK_URL=
# Confiança mínima para um dano de severidade alta abrir chamado sozinho
TICKET_MIN_CONFIDENCE=0.4
# 1 = o painel Streamlit sobe o agendador junto (deploy de processo único)
RUN_SCHEDULER_IN_UI=0
# Modo demonstração: quantas imagens de samples/ entram por execução (0 = desligado)
DEMO_SEED_PER_RUN=0

# --- Armazenamento ---
# Quantas imagens processadas ficam guardadas (cada uma ocupa ~0,8 MB entre etapas e overlay).
# Ao passar do limite, saem primeiro as imagens sem dano (das mais antigas para as mais
# recentes); as com dano só saem quando não resta nenhuma sem dano. 0 = sem limite.
MAX_IMAGES=200

# --- Padrões para fotos sem sidecar ---
DEFAULT_SOURCE=fotos_proprias
DEFAULT_LICENSE=proprio
